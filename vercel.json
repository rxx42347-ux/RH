{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "style.css", "use": "@vercel/static" },
    { "src": "app.js", "use": "@vercel/static" },
    { "src": "ai.js", "use": "@vercel/node" },
    { "src": "status.js", "use": "@vercel/node" },
    { "src": "health.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/ai", "methods": ["POST"], "dest": "/ai.js" },
    { "src": "/api/status", "methods": ["GET"], "dest": "/status.js" },
    { "src": "/api/health", "methods": ["GET"], "dest": "/health.js" }
  ]
}