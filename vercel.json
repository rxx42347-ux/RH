{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/ai",
      "destination": "/ai.js"
    },
    {
      "source": "/api/status",
      "destination": "/status.js"
    },
    {
      "source": "/api/health",
      "destination": "/health.js"
    }
  ],
  "functions": {
    "ai.js": {
      "runtime": "nodejs24.x"
    },
    "status.js": {
      "runtime": "nodejs24.x"
    },
    "health.js": {
      "runtime": "nodejs24.x"
    }
  }
}
